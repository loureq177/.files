      "make *": "allow",
      "nx *": "allow",
      "bats *": "allow",
      "pytest*": "allow",
      "uv *": "allow",
      "uv publish*": "ask",
      "pip *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "*.venv/bin/python*": "allow",
      "node *": "allow",
      "cargo *": "allow",
      "go *": "allow",
