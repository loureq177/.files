{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "pyrefly": {
      "command": ["pyrefly", "lsp"],
      "extensions": [".py", ".pyi"]
    },
    "qmlls": {
      "command": ["qmlls6", "-E", "-I", "/usr/lib/qt6/qml"],
      "extensions": [".qml", ".qmljs"]
    }
  },
  "compaction": {
    "auto": true
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.ssh/*": "ask",
      "*.aws/credentials": "ask",
      "*.gnupg/*": "ask"
    },
    "edit": {
      "*": "allow",
      "*.env": "ask",
      "*.ssh/*": "deny",
      "*.aws/*": "deny",
      "*.gnupg/*": "deny",
      "/etc/**": "deny",
      "/sys/**": "deny",
      "/proc/**": "deny",
      "/usr/**": "deny",
      "/run/**": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/**": "allow",
      "/tmp/**": "allow",
      "/var/folders/**": "allow",
      "/private/var/folders/**": "allow",
      "/etc/**": "allow",
      "/sys/**": "allow",
      "/usr/**": "allow",
      "/run/**": "allow",
      "/opt/**": "allow",
      "/var/log/**": "allow",
      "/boot/**": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "question": "allow",
    "task": "allow",
    "skill": "allow",
    "bash": {
      // catch-all MUST be first - last matching rule wins, so narrow rules go last
      "*": "ask",
      // bare (no-arg) forms: "X *" does not match bare "X", and these all exit immediately
      "echo": "allow",
      "printf": "allow",
      "ls": "allow",
      "pwd": "allow",
      "cd": "allow",
      "find": "allow",
      "sort": "allow",
      "grep": "allow",
      "rg": "allow",
      "fd": "allow",
      "cat": "allow",
      "bat": "allow",
      "eza": "allow",
      "delta": "allow",
      "diff": "allow",
      "which": "allow",
      "type": "allow",
      "file": "allow",
      "head": "allow",
      "tail": "allow",
      "stat": "allow",
      "tree": "allow",
      "man": "allow",
      "date": "allow",
      "ps": "allow",
      "df": "allow",
      "du": "allow",
      "git": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "cd *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "cat *": "allow",
      "bat *": "allow",
      "eza *": "allow",
      "delta *": "allow",
      "duf*": "allow",
      "tldr *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "tee *": "ask",
      "strings *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "which *": "allow",
      "type *": "allow",
      "command -v *": "allow",
      "whereis *": "allow",
      "man *": "allow",
      "date *": "allow",
      "whoami": "allow",
      "hostname*": "allow",
      "uname *": "allow",
      "env": "allow",
      "printenv*": "allow",
      "sysctl -n*": "allow",
      "vm_stat*": "allow",
      "df *": "allow",
      "du *": "allow",
      "free *": "allow",
      "ps *": "allow",
      "top -l *": "allow",
      "uptime": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "mktemp *": "allow",
      "pgrep *": "allow",
      "seq *": "allow",
      "bash -n *": "allow",
      "zsh -n *": "allow",
      "true": "allow",
      "false": "allow",
      "sleep *": "allow",
      "xargs rg *": "allow",
      "xargs grep *": "allow",
      "xargs cat *": "allow",
      "xargs wc *": "allow",
      "find *-exec*": "ask",
      "find *-delete*": "ask",
      "find *-fprint*": "ask",
      "systemctl status *": "allow",
      "systemctl --user status *": "allow",
      "journalctl *": "allow",
      "paru -Q*": "allow",
      "paru -Ss *": "allow",
      "pacman -Q*": "allow",
      "pacman -Ss *": "allow",
      "pacman -Si *": "allow",
      "pacman -Qi *": "allow",
      "checkupdates*": "allow",
