{
  "title": "Caps Lock and Tab as on the Arch desktop (kanata)",
  "rules": [
    {
      "description": "Caps Lock: Escape when tapped, Control when held",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_control", "lazy": true }],
          "to_if_alone": [{ "key_code": "escape" }]
        }
      ]
    },
    {
      "description": "Tab: Tab when tapped; held, hjkl are the arrows and no Tab is typed",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_arrows", "value": 1 }],
          "from": { "key_code": "h", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_arrow" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_arrows", "value": 1 }],
          "from": { "key_code": "j", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "down_arrow" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_arrows", "value": 1 }],
          "from": { "key_code": "k", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "up_arrow" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_arrows", "value": 1 }],
          "from": { "key_code": "l", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "right_arrow" }]
        },
        {
          "type": "basic",
          "from": { "key_code": "tab", "modifiers": { "optional": ["shift"] } },
          "to": [{ "set_variable": { "name": "tab_arrows", "value": 1 } }],
          "to_after_key_up": [{ "set_variable": { "name": "tab_arrows", "value": 0 } }],
          "to_if_alone": [{ "key_code": "tab" }]
        }
      ]
    }
  ]
}
