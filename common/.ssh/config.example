# ~/.ssh/config
# Machine-local SSH configuration. Do NOT commit real hosts/keys.
# Copy to ~/.ssh/config and chmod 600.

# Host github.com
#   HostName github.com
#   User git
#   IdentityFile ~/.ssh/id_ed25519
#   IdentitiesOnly yes

# Host work
#   HostName ssh.example.com
#   User mlorenc
#   IdentityFile ~/.ssh/id_work
#   IdentitiesOnly yes
