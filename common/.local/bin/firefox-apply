#!/usr/bin/env bash
# Deploy Firefox defaults (user.js) into the active default profile.
# This script exists because a plain stow symlink cannot work: the profile
# directory name (e.g. 41mtk0w1.default-release-...) is randomly generated
# per machine/profile, so the target path can never be committed to dotfiles.
# Writes go through the profile-sync-daemon tmpfs profile and are synced
# back to disk automatically.
set -euo pipefail

SRC="${XDG_CONFIG_HOME:-$HOME/.config}/firefox-defaults"
INIFILE="${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox/profiles.ini"

usage() {
    echo "usage: firefox-apply [--extensions]"
    echo "  --extensions   print AMO URLs from extensions.txt"
    exit 1
}

if [ $# -gt 0 ] && [ "$1" = "--extensions" ]; then
    [ -f "$SRC/extensions.txt" ] || { echo "firefox-apply: $SRC/extensions.txt not found"; exit 1; }
    cat "$SRC/extensions.txt"
    exit 0
fi
[ $# -eq 0 ] || usage

[ -f "$SRC/user.js" ] || { echo "firefox-apply: $SRC/user.js not found"; exit 1; }

[ -f "$INIFILE" ] || { echo "firefox-apply: $INIFILE not found"; exit 1; }

PROFILE="$(awk -F= '
    /^\[Install/ { install_section=1; next }
    /^\[/        { install_section=0 }
    install_section && /^Default=/ { default_path=$2 }
    /^\[Profile/   { profile_section=1; next }
    /^\[/          { profile_section=0 }
    profile_section && /^Path=/ { if (default_path == "" || first_path == "") first_path=$2 }
    END { print (default_path != "" ? default_path : first_path) }
' "$INIFILE")"
[ -n "$PROFILE" ] || { echo "firefox-apply: no profile found in profiles.ini"; exit 1; }

PROFILE_DIR="$(readlink -f "${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox/$PROFILE")"
[ -d "$PROFILE_DIR" ] || { echo "firefox-apply: profile dir not found: $PROFILE_DIR"; exit 1; }

install -m 600 "$SRC/user.js" "$PROFILE_DIR/user.js"
echo "[OK] user.js -> $PROFILE_DIR"
