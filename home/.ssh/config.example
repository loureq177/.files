# ~/.ssh/config
# Ignored by git; copy this file to ~/.ssh/config and keep what applies.

# Defaults for every host.
Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 60

# Host github.com
#     User git
#     IdentityFile ~/.ssh/id_ed25519

# Host homelab
#     HostName 192.168.1.10
#     User me
#     IdentityFile ~/.ssh/id_ed25519
