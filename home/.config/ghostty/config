config-file = ?arch.conf
theme = GitHub Dark Default

font-family = JetBrainsMono Nerd Font Mono
font-family = Noto Sans CJK JP
font-size = 12
font-feature = -calt
font-feature = -liga
font-feature = -dlig

cursor-style-blink = false
mouse-hide-while-typing = true
mouse-scroll-multiplier = discrete:1,precision:1
focus-follows-mouse = true
clipboard-read = allow
clipboard-write = deny
confirm-close-surface = false

working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

keybind = ctrl+shift+v=paste_from_clipboard
keybind = shift+insert=paste_from_clipboard
keybind = ctrl+shift+z=undo
# The scrollback a few lines at a time, held for more (as j / k in vim);
# shift+page_up / page_down still go a page.
keybind = ctrl+shift+k=scroll_page_lines:-3
keybind = ctrl+shift+j=scroll_page_lines:3

config-file = ?~/.local/state/ghostty/perf.conf


undo-timeout = 60s
