# Machine-local symlink (XDG_STATE_HOME), flipped by power-save.sh. Never point
# this at a stowed file that power-save.sh edits: ~/.config/ghostty is a stow
# link into the dotfiles repo, so in-place edits there land in git.
custom-shader = ~/.local/state/ghostty/active-shader.glsl
custom-shader-animation = true
theme = GitHub Dark Default

font-family = JetBrainsMono Nerd Font Mono
font-family = Noto Sans CJK JP
font-size = 12
font-feature = -calc

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
mouse-scroll-multiplier = discrete:1,precision:1
focus-follows-mouse = true
clipboard-read = allow
clipboard-write = allow
confirm-close-surface = false
app-notifications = no-clipboard-copy

working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
window-inherit-font-size = true
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
background-opacity = 0.95
background-blur-radius = 20
minimum-contrast = 1.1

# Universal clipboard & selection
keybind = shift+insert=paste_from_clipboard
keybind = ctrl+shift+a=select_all

