{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "github",
    "mode": "system"
  },
  "scroll": {
    "speed": 1
  },
  "diffs": {
    "wrap": "none"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "terminal": true,
    "markdown": "rendered",
    "grouping": "auto"
  },
  "animations": true,
  "tabs": {
    "enabled": true,
    "layout": "horizontal",
    "indicators": "status",
    "scope": "cwd"
  },
  "prompt": {
    "paste": "full"
  },
  "attention": {
    "volume": 1,
    "notifications": true,
    "sound": true
  }
}
