{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "plugin": ["@dietrichgebert/ponytail"],
  "lsp": true,
  "compaction": {
    "auto": true
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "lsp": "allow",
    "question": "allow",
    "task": "allow",
    "edit": "allow",
    "skill": "allow",
    "external_directory": {
      "~/**": "allow"
    },
    "bash": {
      // catch-all MUST be first — subsequent rules override it
      "*": "ask",

      // git — without push/reset/rebase, which remains on "ask"
      "git": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git checkout*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git stash*": "allow",
      "git rev-parse*": "allow",

      // general read/inspection
      "ls": "allow",
      "pwd": "allow",
      "echo": "allow",
      "echo *": "allow",
      "find": "allow",
      "sort": "allow",
      "find *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "fd": "allow",
      "fd *": "allow",
      "bat": "allow",
      "bat *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "which": "allow",
      "which *": "allow",
      "type": "allow",
      "type *": "allow",
      "man": "allow",
      "man *": "allow",
      "file": "allow",
      "file *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "stat": "allow",
      "stat *": "allow",
      "diff": "allow",
      "diff *": "allow",

      // Arch — queries and diagnostics, without install/upgrade
      "paru -q *": "allow",
      "pacman -q *": "allow",
      "pacman -Ss *": "allow",
      "pacman -Si *": "allow",
      "pacman -Qi *": "allow",
      "checkupdates*": "allow",
      "systemctl status *": "allow",
      "systemctl --user status *": "allow",
      "journalctl *": "allow",
      "uname *": "allow",
      "lscpu*": "allow",
      "lsblk*": "allow",
      "free *": "allow",
      "df *": "allow",
      "nvidia-smi*": "allow",
      "stow -n *": "allow",

      // Python
      "python*": "allow",
      "python3*": "allow",
      "pip*": "allow",
      "pip3*": "allow",
      "uv *": "allow",
      "pytest*": "allow",
      "ruff*": "allow",
      "pyrefly*": "allow"
    }
  }
}
