{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "pyrefly": {
      "command": ["pyrefly", "lsp"],
      "extensions": [".py", ".pyi"]
    },
    "qmlls": {
      "command": ["qmlls6", "-E"],
      "extensions": [".qml", ".qmljs"]
    }
  },
  "compaction": {
    "auto": true
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.ssh/*": "ask",
      "*.aws/credentials": "ask",
      "*.gnupg/*": "ask"
    },
    "edit": {
      "*": "allow",
      "*.env": "ask",
      "*.ssh/*": "deny",
      "*.aws/*": "deny",
      "*.gnupg/*": "deny",
      "/etc/**": "deny",
      "/sys/**": "deny",
      "/proc/**": "deny",
      "/usr/**": "deny",
      "/run/**": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/**": "allow",
      "/tmp/**": "allow",
      "/var/folders/**": "allow",
      "/private/var/folders/**": "allow",
      "/etc/**": "allow",
      "/sys/**": "allow",
      "/usr/**": "allow",
      "/run/**": "allow",
      "/opt/**": "allow",
      "/var/log/**": "allow",
      "/boot/**": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "question": "allow",
    "task": "allow",
    "skill": "allow",
    "bash": {
      // catch-all MUST be first - last matching rule wins, so narrow rules go last
      // default allow: safe commands run without prompting, dangerous ones are ask/deny below
      "*": "allow",
      "tee *": "ask",
      "find *-exec*": "ask",
      "find *-delete*": "ask",
      "find *-fprint*": "ask",
      "rm": "ask",
      "rm *": "ask",
      "rmdir": "ask",
      "rmdir *": "ask",
      "unlink *": "ask",
      "shred *": "ask",
      // privilege escalation: no passwordless sudo here and the agent can't
      // type a password, so block outright instead of pointlessly asking
      "sudo": "deny",
      "sudo *": "deny",
      "sudo*": "deny",
      "su": "deny",
      "su *": "deny",
      "doas *": "deny",
      "run0 *": "deny",
      "chmod *": "ask",
      "chown *": "ask",
      "chattr *": "ask",
      "setfattr *": "ask",
      "setfacl *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "fdisk*": "ask",
      "parted*": "ask",
      "wipefs*": "ask",
      "kill *": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "sh -c *": "ask",
      "bash -c *": "ask",
      "zsh -c *": "ask",
      "*|sh*": "ask",
      "*|bash*": "ask",
      "*|zsh*": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "aria2c *": "ask",
      "axel *": "ask",
      "systemctl start*": "ask",
      "systemctl stop*": "ask",
      "systemctl restart*": "ask",
      "systemctl enable*": "ask",
      "systemctl disable*": "ask",
      "systemctl mask*": "ask",
      "systemctl --user start*": "ask",
      "systemctl --user stop*": "ask",
      "systemctl --user restart*": "ask",
      "systemctl --user enable*": "ask",
      "systemctl --user disable*": "ask",
      "docker rm*": "ask",
      "docker rmi*": "ask",
      "docker system*": "ask",
      "docker volume*": "ask",
      "docker network rm*": "ask",
      "docker container prune*": "ask",
      "docker image prune*": "ask",
      "docker builder prune*": "ask",
      "kubectl delete*": "ask",
      "kubectl apply*": "ask",
      "kubectl create*": "ask",
      "kubectl exec*": "ask",
      "kubectl port-forward*": "ask",
      "kubectl scale*": "ask",
      "kubectl rollout*": "ask",
      "kubectl patch*": "ask",
      "kubectl edit*": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "terraform import*": "ask",
      "terraform taint*": "ask",
      "terraform untaint*": "ask",
      "terraform state*": "ask",
      "gh pr merge*": "ask",
      "gh pr close*": "ask",
      "gh release delete*": "ask",
      "gh repo delete*": "ask",
      "glab mr merge*": "ask",
      "glab mr close*": "ask",
      "glab release delete*": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git rebase*": "ask",
      "git branch -D*": "ask",
      "git branch -d*": "ask",
      "git tag -d*": "ask",
      "git checkout -- *": "ask",
      "git restore*": "ask",
      "git filter-branch*": "ask",
      "git remote add*": "ask",
      "git remote remove*": "ask",
      "git remote set-url*": "ask",
      "git submodule*": "ask",
      "uv publish*": "ask",
      // narrow overrides MUST stay last: last matching rule wins
      // Anything that fetches and executes remote code: prompt instead of allow.
      "npm ci": "ask",
      "npm install*": "ask",
      "npm i *": "ask",
      "npm add*": "ask",
      "pip install*": "ask",
      "uv add*": "ask",
      "uv pip install*": "ask",
      "uv tool install*": "ask",
      "bun add*": "ask",
      "bun install*": "ask",
      "pnpm add*": "ask",
      "pnpm install*": "ask",
      "yarn add*": "ask",
      "yarn install*": "ask",
      "sed -i*": "ask",
      "nvim*": "deny",
      "vim*": "deny",
      "lazygit*": "deny",
      "lazydocker*": "deny",
      "btop*": "deny",
      "htop*": "deny",
      "yazi*": "deny",
      "fzf*": "deny",
      "termshark*": "deny",
      "mysql *": "deny",
      "ssh *": "deny"
    }
  }
}
