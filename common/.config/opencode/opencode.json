{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "lsp": "allow",
    "question": "allow",
    "task": "allow",
    "edit": "allow",
    "skill": "allow",
    "external_directory": {
      "~/**": "allow"
    },
    "bash": {
      "git": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git checkout*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git stash*": "allow",
      "git rev-parse*": "allow",
      "ls": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "echo": "allow",
      "find *": "allow",
      "find": "allow",
      "grep *": "allow",
      "grep": "allow",
      "cat *": "allow",
      "cat": "allow",
      "paru -q *": "allow",
      "pacman -q *": "allow",
      "rg *": "allow",
      "rg": "allow",
      "fd *": "allow",
      "fd": "allow",
      "bat *": "allow",
      "bat": "allow",
      "tree *": "allow",
      "tree": "allow",
      "which *": "allow",
