      "man *": "allow",
      "man": "allow",
      "systemctl status *": "allow",
      "journalctl *": "allow",
      "file *": "allow",
      "file": "allow",
      "head *": "allow",
      "head": "allow",
      "tail *": "allow",
      "tail": "allow",
      "stat *": "allow",
      "stat": "allow",
      "diff *": "allow",
      "diff": "allow",
      "*": "ask"
    }
