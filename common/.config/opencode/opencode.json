      "./vendor/bin/*": "allow",
      "pyenv version*": "allow",
      "eslint *": "allow",
      "prettier *": "allow",
      "ruff *": "allow",
      "black *": "allow",
      "mypy *": "allow",
      "ty check*": "allow",
      "pyrefly *": "allow",
      "isort *": "allow",
      "autoflake *": "allow",
      "gofmt *": "allow",
      "golangci-lint *": "allow",
      "biome *": "allow",
      "shellcheck *": "allow",
      "shfmt *": "allow",
      "stow *": "allow",
      "docker ps*": "allow",
      "docker logs*": "allow",
      "docker images*": "allow",
      "docker inspect*": "allow",
      "docker info*": "allow",
      "docker version*": "allow",
      "docker --version*": "allow",
      "docker image ls*": "allow",
      "docker port*": "allow",
      "docker network inspect*": "allow",
      "docker context ls*": "allow",
      "docker context show*": "allow",
      "docker stats*": "allow",
      "docker network ls*": "allow",
      "docker exec *": "allow",
      "docker compose ps*": "allow",
      "docker compose logs*": "allow",
      "docker compose config*": "allow",
      "docker compose up*": "allow",
      "docker compose down*": "allow",
      "docker compose start*": "allow",
      "docker compose stop*": "allow",
      "docker compose restart*": "allow",
      "docker compose build*": "allow",
      "docker compose exec *": "allow",
      "podman ps*": "allow",
      "podman logs*": "allow",
      "podman images*": "allow",
      "podman inspect*": "allow",
      "podman info*": "allow",
      "podman version*": "allow",
      "podman stats*": "allow",
      "podman compose ps*": "allow",
      "podman compose logs*": "allow",
      "podman compose config*": "allow",
      "podman compose up*": "allow",
      "podman compose down*": "allow",
      "podman compose build*": "allow",
      "podman compose restart*": "allow",
      "kubectl get*": "allow",
      "kubectl describe*": "allow",
      "kubectl logs*": "allow",
      "kubectl config get*": "allow",
      "kubectl config view*": "allow",
      "kubectl top*": "allow",
      "terraform plan*": "allow",
      "terraform validate*": "allow",
      "terraform fmt*": "allow",
      "terraform show*": "allow",
      "terraform output*": "allow",
      "glab mr view*": "allow",
      "glab mr list*": "allow",
      "glab mr diff*": "allow",
      "glab mr note list*": "allow",
      "glab ci view*": "allow",
      "glab ci status*": "allow",
      "glab ci list*": "allow",
      "glab ci trace*": "allow",
      "glab ci lint*": "allow",
      "glab issue view*": "allow",
      "glab issue list*": "allow",
      "glab repo view*": "allow",
      "glab release list*": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "ask",
      "mv *": "ask",
      "ln *": "ask",
      // narrow overrides MUST stay last: last matching rule wins
      // Anything that fetches and executes remote code: prompt instead of allow.
      "npm ci": "ask",
      "npm install*": "ask",
      "npm i *": "ask",
      "npm add*": "ask",
      "pip install*": "ask",
      "uv add*": "ask",
      "uv pip install*": "ask",
      "uv tool install*": "ask",
      "bun add*": "ask",
      "bun install*": "ask",
      "pnpm add*": "ask",
      "pnpm install*": "ask",
      "yarn add*": "ask",
      "yarn install*": "ask",
      "sed -i*": "ask",
      "nvim*": "deny",
      "vim*": "deny",
      "lazygit*": "deny",
      "lazydocker*": "deny",
      "btop*": "deny",
