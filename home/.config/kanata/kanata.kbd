;; Caps Lock: Escape tapped, Control held; held, hjkl are the arrows (Shift kept).
;; On Linux with Alt or Super down they stay CTRL + hjkl: SUPER + CTRL resizes windows.
(defcfg
  process-unmapped-keys yes
)

(defsrc caps h j k l play pause)

(defalias
  cap (tap-hold-press 0 200 esc (multi lctl (layer-while-held arrows)))
  ;; Taps only: the Px8 S2 USB dongle holds Play while worn and Pause once off, and a
  ;; held bound key makes Hyprland drop the first key after a modifier combo.
  play (macro play)
  pause (macro pause)
)

;; KEY_PLAY has no kanata name.
(deflocalkeys-linux play 207)
(deflocalkeys-macos play 207)

(platform (linux)
  (defalias
    ← (fork (unmod (lctl) left) h (lalt lmet))
    ↓ (fork (unmod (lctl) down) j (lalt lmet))
    ↑ (fork (unmod (lctl) up) k (lalt lmet))
    → (fork (unmod (lctl) right) l (lalt lmet))
  )
)

(platform (macos)
  (defalias
    ← (unmod (lctl) left)
    ↓ (unmod (lctl) down)
    ↑ (unmod (lctl) up)
    → (unmod (lctl) right)
  )
)

(deflayer base @cap h j k l @play @pause)

(deflayer arrows _ @← @↓ @↑ @→ @play @pause)
