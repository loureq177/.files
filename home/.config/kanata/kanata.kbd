;; Caps Lock: Escape tapped, Control held; held, hjkl are the arrows (Shift kept).
;; On Linux with Alt or Super down they stay CTRL + hjkl: SUPER + CTRL resizes windows.
;; On macOS the function row is spelled out (below): kanata grabs the keyboard whole, and the
;; keys it passes on unmapped turn into plain F1-F12 instead of brightness, volume and the rest.
(defcfg
  process-unmapped-keys yes
)

(defsrc caps h j k l f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12)

(defalias
  cap (tap-hold-press 0 200 esc (multi lctl (layer-while-held arrows)))
)

(platform (linux)
  (defalias
    r1 f1 r2 f2 r3 f3 r4 f4 r5 f5 r6 f6 r7 f7 r8 f8 r9 f9 r10 f10 r11 f11 r12 f12
    ← (fork (unmod (lctl) left) h (lalt lmet))
    ↓ (fork (unmod (lctl) down) j (lalt lmet))
    ↑ (fork (unmod (lctl) up) k (lalt lmet))
    → (fork (unmod (lctl) right) l (lalt lmet))
  )
)

(platform (macos)
  (defalias
    r1 brdn r2 brup r3 mctl r4 sls r5 dtn r6 dnd r7 prev r8 pp r9 next r10 mute r11 vold r12 volu
    ← (unmod (lctl) left)
    ↓ (unmod (lctl) down)
    ↑ (unmod (lctl) up)
    → (unmod (lctl) right)
  )
)

(deflayer base @cap h j k l @r1 @r2 @r3 @r4 @r5 @r6 @r7 @r8 @r9 @r10 @r11 @r12)

(deflayer arrows _ @← @↓ @↑ @→ _ _ _ _ _ _ _ _ _ _ _ _)
