{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "github",
    "mode": "system"
  },
  "scroll": {
    "speed": 1,
    "acceleration": true
  },
  "diffs": {
    "wrap": "none"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "terminal": true,
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "high",
    "tps": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "enabled": true,
    "layout": "vertical",
    "indicators": "status",
    "scope": "global"
  },
  "prompt": {
    "paste": "full"
  },
  "attention": {
    "volume": 1,
    "notifications": true,
    "sound": true
  }
}
