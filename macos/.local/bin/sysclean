#!/usr/bin/env zsh
# macOS system cleanup: Homebrew, trash, dev caches (uv/npm/etc.), and container prune.
set -euo pipefail

_log_info() { echo "\033[0;34m[sysclean]\033[0m $*"; }

run_if() {
    command -v "$1" >/dev/null 2>&1 || return 0
    shift
    "$@" </dev/null 2>/dev/null || true
}

avail_bytes() {
    # Available bytes on /. APFS shares space across volumes, so only track /.
    df -k / 2>/dev/null | awk 'NR==2 {print $4 * 1024}'
}

human_bytes() {
    local bytes="${1:-0}"
    if command -v numfmt >/dev/null 2>&1 && numfmt --to=iec-i --suffix=B -- 1 >/dev/null 2>&1; then
        numfmt --to=iec-i --suffix=B -- "$bytes" 2>/dev/null || echo "$bytes B"
    else
        awk -v b="$bytes" 'BEGIN {
            if (b >= 1073741824) printf "%.2f GiB\n", b / 1073741824;
            else if (b >= 1048576) printf "%.2f MiB\n", b / 1048576;
            else if (b >= 1024) printf "%.2f KiB\n", b / 1024;
            else printf "%d B\n", b;
        }'
    fi
}

print_total() {
    # Prominent final summary. No ui.sh on macOS, so use standard bold green.
    local freed_h="$1"
    local green bold reset
    green="$(printf '\033[1;32m')"
    bold=""
    reset="$(printf '\033[0m')"
    echo ""
    echo "${green}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}"
    echo "${bold}${green}  Total reclaimed space: ${freed_h}${reset}"
    echo "${green}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}"
}

AVAIL_BEFORE=$(avail_bytes)

if command -v brew >/dev/null 2>&1; then
    _log_info "Cleaning Homebrew cache & old versions..."
    brew cleanup --prune=all 2>/dev/null || true
    brew autoremove 2>/dev/null || true
fi

_log_info "Emptying trash..."
rm -rf "$HOME/.Trash/"*(N) 2>/dev/null || true

_log_info "Cleaning miscellaneous macOS caches..."
rm -rf "$HOME/Library/Caches/Homebrew/"*(N) 2>/dev/null || true
run_if qlmanage qlmanage -r cache

_log_info "Cleaning Python, Node & dev caches..."
run_if uv uv cache prune
run_if pip pip cache purge
run_if bun bun pm cache rm
run_if npm npm cache clean --force
run_if yarn yarn cache clean

_log_info "Pruning container engines (per-engine details above)..."
run_if podman podman system prune --force
run_if docker docker system prune -f

_log_info "System is clean."

AVAIL_AFTER=$(avail_bytes)
FREED_BYTES=$((AVAIL_AFTER - AVAIL_BEFORE))
if [ "$FREED_BYTES" -lt 0 ]; then FREED_BYTES=0; fi
print_total "$(human_bytes "$FREED_BYTES")"
