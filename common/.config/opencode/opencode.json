      "brew info*": "allow",
      "brew deps*": "allow",
      "brew outdated*": "allow",
      "brew doctor*": "allow",
      "brew search*": "allow",
      "brew --prefix*": "allow",
      "brew --version*": "allow",
      "opencode debug *": "allow",
      "opencode --*": "allow",
      "git *": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git rebase*": "ask",
      "git branch -D*": "ask",
      "git branch -d*": "ask",
      "git tag -d*": "ask",
      "git checkout -- *": "ask",
      "git restore*": "ask",
      "git filter-branch*": "ask",
      "git remote add*": "ask",
      "git remote remove*": "ask",
      "git remote set-url*": "ask",
      "git submodule*": "ask",
      "npm run *": "allow",
      "npm test*": "allow",
