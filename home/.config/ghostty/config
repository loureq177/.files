config-file = ?arch.conf
theme = GitHub Dark Default

font-family = JetBrainsMono Nerd Font Mono
font-family = Noto Sans CJK JP
font-feature = -calt
font-size = 15

cursor-style-blink = false
mouse-hide-while-typing = true
mouse-scroll-multiplier = discrete:1,precision:1
focus-follows-mouse = true

confirm-close-surface = false
clipboard-read = allow
clipboard-write = deny

window-inherit-working-directory = false
tab-inherit-working-directory = true
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

macos-option-as-alt = left

keybind = ctrl+shift+v=paste_from_clipboard
keybind = shift+insert=paste_from_clipboard

keybind = ctrl+shift+k=scroll_page_fractional:-0.5
keybind = ctrl+shift+j=scroll_page_fractional:0.5

keybind = performable:shift+left=goto_split:left
keybind = performable:shift+down=goto_split:bottom
keybind = performable:shift+up=goto_split:top
keybind = performable:shift+right=goto_split:right

keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down

# Ctrl+Alt, not Alt: Option+L and Option+Shift+L type ł and Ł.
keybind = ctrl+alt+shift+h=new_split:left
keybind = ctrl+alt+shift+j=new_split:down
keybind = ctrl+alt+shift+k=new_split:up
keybind = ctrl+alt+shift+l=new_split:right

config-file = ?~/.local/state/ghostty/perf.conf
# This machine's own, out of git (working-directory and the like).
config-file = ?config.local


undo-timeout = 60s
